    "demo": "tsx src/cli.ts demo",
    "mcp": "tsx src/cli.ts mcp",
    "dashboard": "tsx src/cli.ts dashboard",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "openai": "^7.43.0",
